{
  "name": "sistema-estudiantes/laravel",
  "description": "Sistema de gestión escolar en PHP puro con MySQL",
  "type": "project",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "classmap": [
      "app/"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\": "database/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "scripts": {
    "start": "php -S localhost:8000 -t public",
    "serve": "php -S localhost:8000 -t public"
  }
}
